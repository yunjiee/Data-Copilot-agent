# 使用方式：複製成 .env 後填入自己的值（.env 不會進版控）
#   cp .env.example .env

# ==============================================================================
# Google Vertex AI
# ==============================================================================
# 沒有設定 GOOGLE_API_KEY 時走 Vertex AI（需先 gcloud auth application-default login）
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
# 若改用 AI Studio，改設 API 金鑰（請勿 commit）
# GOOGLE_API_KEY=

# ==============================================================================
# Agent 模型
# ==============================================================================
WORKER_MODEL=gemini-3.1-pro-preview

# ==============================================================================
# Agent 執行設定
# ==============================================================================
# Text-to-SQL 驗證失敗後，允許模型自我修正的最大次數
MAX_SQL_FIX_ITERATIONS=3
# 輸出與快取根目錄（相對路徑以專案根目錄為基準）
MAS_PROJECT_ROOT=mas_output
# 等待 MCP Server 子程序啟動的秒數（ADK 預設 5 秒；冷啟動 import bigquery 可能超過）
MCP_STARTUP_TIMEOUT=60

# ==============================================================================
# BigQuery 執行設定
# ==============================================================================
# 建立 Query Job 並計費的專案
BIGQUERY_PROJECT=${GOOGLE_CLOUD_PROJECT}
# 資料所在的專案與資料集（只允許查詢這個範圍）
BIGQUERY_DATA_PROJECT=bigquery-public-data
BIGQUERY_DATASET=thelook_ecommerce
BIGQUERY_LOCATION=US
# 單次查詢計費上限（位元組），104857600 = 100 MiB
MAXIMUM_BYTES_BILLED=104857600

# ==============================================================================
# Local RAG MCP Server
# ==============================================================================
# 本機多語言 Embedding 模型
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Qdrant Collection 名稱
RAG_COLLECTION_NAME=ecommerce_internal_knowledge
# 每個文件片段的字元數
RAG_CHUNK_SIZE=180
# 相鄰片段重疊的字元數
RAG_CHUNK_OVERLAP=30
# 每次檢索預設回傳筆數
RAG_TOP_K=5
# Embedding 批次大小
RAG_EMBEDDING_BATCH_SIZE=16
# 原始知識文件目錄
RAG_SOURCE_DIR=data/knowledge_base
# Qdrant 本機向量資料儲存位置
RAG_QDRANT_PATH=data/qdrant
# RAG 後端：langchain 或 native（native 或直接註解掉＝原生手寫版）
RAG_BACKEND=langchain
